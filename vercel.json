{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/api/task/start",          "destination": "/api/task" },
    { "source": "/api/task/progress",        "destination": "/api/task" },
    { "source": "/api/task/finish",          "destination": "/api/task" },
    { "source": "/api/impact/apply",         "destination": "/api/impact" },
    { "source": "/api/trace/stage-complete", "destination": "/api/trace" },
    { "source": "/api/rewards/quiz",         "destination": "/api/rewards" },
    { "source": "/api/rewards/reset",        "destination": "/api/rewards" },
    { "source": "/api/demo/scenario",        "destination": "/api/demo" },
    { "source": "/(.*)",                     "destination": "/index.html" }
  ]
}
